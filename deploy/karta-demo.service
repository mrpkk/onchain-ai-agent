[Unit]
Description=KARTA public demo — spend-control verdicts (rta.lat/karta)
Documentation=https://karta.rta.lat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iamthat
WorkingDirectory=/media/Sruti/iamthat/work/onchain-ai-agent/backend
Environment=KARTA_DEMO_EVENTS=/media/Sruti/iamthat/.local/share/karta-demo/events.jsonl
ExecStart=/media/Sruti/iamthat/work/onchain-ai-agent/backend/.venv/bin/python -m uvicorn src.demo.app:app --host 127.0.0.1 --port 8295
Restart=always
RestartSec=2
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
