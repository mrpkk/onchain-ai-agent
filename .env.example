# ─── Application ────────────────────────────────────────────────────────
APP_NAME="OnChain AI Agent"
APP_VERSION=0.1.0
DEBUG=false

# ─── Server ─────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ─── JWT Authentication ────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://agent:agent@127.0.0.1:5433/onchain_ai

# ─── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Blockchain ─────────────────────────────────────────────────────────
# Ethereum JSON-RPC endpoint (Alchemy, Infura, or public RPC)
ETHEREUM_RPC_URL=https://eth.llamarpc.com
# 1=mainnet, 11155111=sepolia, 8453=base, 42161=arbitrum
CHAIN_ID=1
# Agent wallet private key (no 0x prefix) — NEVER commit to git
AGENT_WALLET_PRIVATE_KEY=

# ─── CORS ───────────────────────────────────────────────────────────────
# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Agent Defaults ────────────────────────────────────────────────────
DEFAULT_MAX_TX_PER_DAY=50
DEFAULT_GAS_LIMIT=300000
KILL_SWITCH_ENABLED=true
